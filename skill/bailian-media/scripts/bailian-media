#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -x "$HOME/.cc-switch/tools/bailian-media" ]; then
  exec "$HOME/.cc-switch/tools/bailian-media" "$@"
fi

REPO_CLI="$SCRIPT_DIR/../tools/bailian-media"
if [ -x "$REPO_CLI" ]; then
  exec "$REPO_CLI" "$@"
fi

echo "bailian-media CLI not found. Run scripts/install.sh from the repository root." >&2
exit 127
